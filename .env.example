# owner/name of the GitDb repository that stores your photos and videos.
# Make it private to share only with collaborators, public to share with everyone.
PIXEL_REPO=charles2ke/pixel-data
PIXEL_BRANCH=main

# Visitor audit log. Use a PRIVATE repository: entries contain visitor IP addresses.
# The token needs "Contents: Read and write" on PIXEL_AUDIT_REPO only.
PIXEL_AUDIT_REPO=charles2ke/pixel-audit
PIXEL_AUDIT_TOKEN=
PIXEL_AUDIT_FLUSH_SECONDS=10

# Largest upload in MB (GitHub rejects files above 100 MB).
PIXEL_MAX_UPLOAD_MB=50

# Set to 1 behind a reverse proxy so the real visitor address is audited.
PIXEL_TRUST_PROXY=0
